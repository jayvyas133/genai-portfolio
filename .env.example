POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicore
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicore
REDIS_URL=redis://localhost:6379/0

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me

ANTHROPIC_API_KEY=

# aicore LLM client (see packages/aicore/README.md)
# AICORE_PROVIDER: fake | ollama | cloudflare
AICORE_PROVIDER=fake
# Chat model for answers and the eval judge
# (DocuMind uses Cloudflare @cf/meta/llama-3.3-70b-instruct-fp8-fast)
AICORE_MODEL=fake-model
# Default models for LLMClient.embed / LLMClient.rerank
# (Cloudflare: @cf/baai/bge-base-en-v1.5 and @cf/baai/bge-reranker-base)
AICORE_EMBED_MODEL=fake-model
AICORE_RERANK_MODEL=fake-model
AICORE_API_KEY=
AICORE_TIMEOUT_S=30
AICORE_MAX_RETRIES=3
# Cache TTL (time to live) in seconds; default one day
AICORE_CACHE_TTL_S=86400
AICORE_OLLAMA_BASE_URL=http://localhost:11434
# Cloudflare: AICORE_API_KEY holds the API token
AICORE_CLOUDFLARE_ACCOUNT_ID=

# DocuMind (projects/01-documind). Uses its own database in the shared
# pgvector container; `uv run documind init-db` creates it.
DOCUMIND_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documind
# Words per chunk and overlap between neighbouring chunks. 200 keeps every
# chunk under the embedding model's 512-token limit (measured, see ADR 0009)
DOCUMIND_CHUNK_WORDS=200
DOCUMIND_CHUNK_OVERLAP_WORDS=40
# Texts per embedding call (Cloudflare allows at most 100)
DOCUMIND_EMBED_BATCH_SIZE=50
# Must match AICORE_EMBED_MODEL (bge-base-en-v1.5 = 768)
DOCUMIND_EMBEDDING_DIMENSIONS=768
# Cap on one HTTP /ask request in seconds (504 past it). Keep it below
# gunicorn's --timeout (60 s in projects/01-documind/Dockerfile)
DOCUMIND_REQUEST_TIMEOUT_S=30
# Reranking retrievers (dense-rerank, hybrid-rerank) also need AICORE_RERANK_MODEL
# set to a real model, e.g. @cf/baai/bge-reranker-base
# Optional: folder with golden.jsonl and results/ (default: projects/01-documind/evals)
# DOCUMIND_EVALS_DIR=

# Deep Research (projects/02-deep-research). All optional; defaults shown.
# Agent budgets: at most 2 + sub-questions + 2 * revisions LLM calls per report
# DEEP_RESEARCH_MAX_SUB_QUESTIONS=3
# DEEP_RESEARCH_QUERIES_PER_SUB_QUESTION=2
# DEEP_RESEARCH_PASSAGES_PER_SUB_QUESTION=4
# DEEP_RESEARCH_MAX_REVISIONS=1
# Research service: job queue in Redis (docker compose sets redis://redis:6379/0)
# DEEP_RESEARCH_REDIS_URL=redis://localhost:6379/0
# Jobs one worker process runs at once (1 suits a local Ollama)
# DEEP_RESEARCH_WORKER_CONCURRENCY=1
# Queued + running jobs before POST /research answers 429
# DEEP_RESEARCH_MAX_PENDING_JOBS=20
# Hard cap on one job, in seconds; a dead worker's job is reclaimed 60 s after it
# DEEP_RESEARCH_JOB_TIMEOUT_S=900
# Seconds finished jobs, reports and events are kept
# DEEP_RESEARCH_RESULT_TTL_S=86400

# Text-to-SQL agent (projects/03-text-to-sql-agent). `uv run text-to-sql load-db`
# creates the chinook database and the read-only role named in DATABASE_URL.
# TEXT_TO_SQL_DATABASE_URL=postgresql://sql_agent_ro:sql_agent_ro@localhost:5432/chinook
# Owner connection, used only by load-db
# TEXT_TO_SQL_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Per-query cap enforced by Postgres, and rows returned before truncating
# TEXT_TO_SQL_STATEMENT_TIMEOUT_MS=10000
# TEXT_TO_SQL_MAX_ROWS=200
# Agent budgets: SQL-writing calls per turn (first try + repairs), and
# earlier turns replayed into the prompt
# TEXT_TO_SQL_MAX_ATTEMPTS=3
# TEXT_TO_SQL_HISTORY_TURNS=3
# Conversation memory for the API (LangGraph checkpoints): its own database
# and read-write role, never the agent's read-only one. `init-memory` creates both.
# TEXT_TO_SQL_MEMORY_DATABASE_URL=postgresql://sql_agent_app:sql_agent_app@localhost:5432/text_to_sql_memory
# API: per-turn time limit (keep below gunicorn's 150 s) and pool size per worker
# TEXT_TO_SQL_REQUEST_TIMEOUT_S=120
# TEXT_TO_SQL_POOL_MAX_SIZE=4
# Docker compose: passwords for the two roles (defaults are for local use only)
# TEXT_TO_SQL_RO_PASSWORD=sql_agent_ro
# TEXT_TO_SQL_APP_PASSWORD=sql_agent_app

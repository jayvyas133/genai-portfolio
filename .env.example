POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicore
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicore
REDIS_URL=redis://localhost:6379/0

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me

ANTHROPIC_API_KEY=

# aicore LLM client (see packages/aicore/README.md)
# AICORE_PROVIDER: fake | ollama
AICORE_PROVIDER=fake
AICORE_MODEL=fake-model
AICORE_API_KEY=
AICORE_TIMEOUT_S=30
AICORE_MAX_RETRIES=3
AICORE_OLLAMA_BASE_URL=http://localhost:11434

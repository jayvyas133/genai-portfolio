POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aicore
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicore
REDIS_URL=redis://localhost:6379/0

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me

ANTHROPIC_API_KEY=

# aicore LLM client (see packages/aicore/README.md)
# AICORE_PROVIDER: fake | ollama | cloudflare
AICORE_PROVIDER=fake
AICORE_MODEL=fake-model
# Default models for LLMClient.embed / LLMClient.rerank
# (Cloudflare: @cf/baai/bge-base-en-v1.5 and @cf/baai/bge-reranker-base)
AICORE_EMBED_MODEL=fake-model
AICORE_RERANK_MODEL=fake-model
AICORE_API_KEY=
AICORE_TIMEOUT_S=30
AICORE_MAX_RETRIES=3
# Cache TTL (time to live) in seconds; default one day
AICORE_CACHE_TTL_S=86400
AICORE_OLLAMA_BASE_URL=http://localhost:11434
# Cloudflare: AICORE_API_KEY holds the API token
AICORE_CLOUDFLARE_ACCOUNT_ID=

# DocuMind (projects/01-documind). Uses its own database in the shared
# pgvector container; `uv run documind init-db` creates it.
DOCUMIND_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documind
# Words per chunk and overlap between neighbouring chunks
DOCUMIND_CHUNK_WORDS=300
DOCUMIND_CHUNK_OVERLAP_WORDS=50
# Texts per embedding call (Cloudflare allows at most 100)
DOCUMIND_EMBED_BATCH_SIZE=50
# Must match AICORE_EMBED_MODEL (bge-base-en-v1.5 = 768)
DOCUMIND_EMBEDDING_DIMENSIONS=768
